# =========================
# Docker 单机生产环境样例
# =========================
# 复制为 .env.production 后再替换占位值：
# Copy-Item '.\.env.production.example' '.\.env.production'
# 如果密码或密钥中包含 $，请用单引号包住完整值，避免 Docker Compose 把它当变量插值。

APP_ENV=production
DB_SCHEMA_BOOTSTRAP_MODE=validate_only
INIT_ADMIN_ENABLED=false
JOB_HEARTBEAT_STALE_SECONDS=120
JOB_RETENTION_DAYS=30
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=15

# =========================
# 外部 PostgreSQL / Redis
# =========================
# 连接宿主机服务时可先使用 host.docker.internal；如果服务器 Docker 不支持该名称，
# 请替换为宿主机内网 IP 或 Docker 网关 IP。
POSTGRES_JDBC_URL=jdbc:postgresql://host.docker.internal:5432/stockproject
POSTGRES_USER=stockproject
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_MAINTENANCE_DB=postgres
DB_AUTO_CREATE_DATABASE=false
DB_AUTO_CREATE_TABLES=false

REDIS_JDBC_URL=jdbc:redis://host.docker.internal:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-redis-password-if-enabled

# =========================
# Auth / 安全
# =========================
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=

# 单端口部署时，浏览器只访问 Nginx；按真实服务器地址替换。
CORS_ALLOW_ORIGINS=http://SERVER_IP:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ORIGIN_REGEX=

# =========================
# 首个管理员
# =========================
# 生产默认不自动创建管理员。如确需首次初始化，请临时设置 INIT_ADMIN_ENABLED=true，
# 启动成功后再改回 false 并重新部署。
INIT_ADMIN_USERNAME=
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# =========================
# 邮件与验证码
# =========================
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=replace-with-smtp-password-if-enabled
SMTP_FROM=
SMTP_PORT=465
SMTP_USE_SSL=true

# =========================
# 股票 / 新闻 / 任务
# =========================
TUSHARE_TOKEN=
STOCK_SYNC_TRADE_DAYS=120
STOCK_DAILY_CACHE_TTL_SECONDS=600
HOT_NEWS_CACHE_TTL_SECONDS=3600
POLICY_NEWS_CACHE_TTL_SECONDS=1800
POLICY_SYNC_ENABLED=true
POLICY_SYNC_LOOKBACK_DAYS=7
POLICY_SOURCE_TIMEOUT_SECONDS=8
POLICY_SOURCE_MAX_ITEMS_PER_PROVIDER=50
POLICY_SYNC_MAX_CONCURRENT_REQUESTS=3
POLICY_PROVIDER_GOV_CN_ENABLED=true
POLICY_PROVIDER_NPC_ENABLED=true
POLICY_PROVIDER_PBC_ENABLED=true
POLICY_PROVIDER_CSRC_ENABLED=true
POLICY_PROVIDER_NDRC_ENABLED=true
POLICY_PROVIDER_MIIT_ENABLED=true
STOCK_RELATED_NEWS_CACHE_TTL_SECONDS=3600
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=5
ANALYSIS_RUNNING_STALE_SECONDS=900

# =========================
# LLM / 联网增强
# =========================
LLM_BASE_URL=https://api.openai.com
LLM_WIRE_API=responses
LLM_API_KEY=replace-with-llm-api-key-if-enabled
LLM_MODEL=gpt-5.1-codex-mini
LLM_REASONING_EFFORT=high
LLM_STREAM_ENABLED=true
LLM_WEB_SEARCH_ENABLED=false

# 前端 Docker 构建默认使用 /api 同源代理，此变量主要保留给非 Docker 构建场景。
VITE_API_BASE_URL=/api
